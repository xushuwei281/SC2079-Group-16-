<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/spacing_6"
    android:background="@color/background_body">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        style="@style/TextAppearance.Heading"
        android:textSize="24sp"
        android:layout_marginBottom="@dimen/spacing_4" />

    <LinearLayout
        android:id="@+id/devicePickerPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/paired_devices_label"
            style="@style/TextAppearance.Label"
            android:textSize="16sp"
            android:layout_marginBottom="@dimen/spacing_2" />

        <LinearLayout
            android:id="@+id/devicePickerCard"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card"
            android:elevation="@dimen/elevation_low"
            android:orientation="vertical"
            android:padding="@dimen/spacing_3">

            <Button
                android:id="@+id/refreshButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/refresh_button"
                style="@style/Widget.Button.Secondary"
                android:layout_marginBottom="@dimen/spacing_2" />

            <ListView
                android:id="@+id/deviceList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:divider="@color/border_subtle"
                android:dividerHeight="1dp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/controlPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="2dp">

            <View
                android:id="@+id/statusDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="@dimen/spacing_2"
                android:background="@drawable/shape_dot"
                android:backgroundTint="@color/text_disabled" />

            <TextView
                android:id="@+id/connectedDeviceLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:text="@string/not_connected" />

            <Button
                android:id="@+id/disconnectButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Widget.Button.Secondary"
                android:text="@string/disconnect_button" />
        </LinearLayout>

        <TextView
            android:id="@+id/linkStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginBottom="@dimen/spacing_2"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:text="@string/link_status_not_connected" />

        <!-- Astryx SegmentedControl: Mode Switcher -->
        <LinearLayout
            android:id="@+id/modeSegmentedTrack"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/bg_astryx_segmented_track"
            android:orientation="horizontal"
            android:padding="3dp"
            android:layout_marginBottom="@dimen/spacing_2">

            <TextView
                android:id="@+id/tabManual"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:background="@drawable/bg_astryx_segmented_thumb"
                android:text="@string/mode_manual"
                android:textColor="@color/segmented_thumb_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabTask1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:background="@null"
                android:text="@string/mode_task1"
                android:textColor="@color/segmented_unselected_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabTask2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:background="@null"
                android:text="@string/mode_task2"
                android:textColor="@color/segmented_unselected_text"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Mode Panels -->
        <!-- 1. Manual Teleop Panel: Drive (joystick) / Arena (obstacle map) sub-toggle -->
        <LinearLayout
            android:id="@+id/panelManual"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3"
            android:orientation="vertical"
            android:layout_marginBottom="@dimen/spacing_2"
            android:visibility="visible">

            <!-- Astryx SegmentedControl: Drive / Arena Sub-Toggle -->
            <LinearLayout
                android:id="@+id/driveArenaSegmentedTrack"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:background="@drawable/bg_astryx_segmented_track"
                android:orientation="horizontal"
                android:padding="2dp"
                android:layout_marginBottom="@dimen/spacing_2">

                <TextView
                    android:id="@+id/driveModeButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:background="@drawable/bg_astryx_segmented_thumb"
                    android:text="@string/drive_mode_button"
                    android:textColor="@color/segmented_thumb_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/arenaModeButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:background="@null"
                    android:text="@string/arena_mode_button"
                    android:textColor="@color/segmented_unselected_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/joystickPanel"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:visibility="visible">

                <com.sc2079.group16.controller.JoystickView
                    android:id="@+id/joystick"
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:layout_gravity="center" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/arenaPanel"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="@dimen/spacing_2">

                    <Button
                        android:id="@+id/addObstacleButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/spacing_1"
                        style="@style/Widget.Button.Secondary"
                        android:text="@string/add_obstacle_button" />

                    <Button
                        android:id="@+id/clearObstaclesButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_1"
                        android:layout_marginEnd="@dimen/spacing_1"
                        style="@style/Widget.Button.Secondary"
                        android:text="@string/clear_obstacles_button" />

                    <Button
                        android:id="@+id/sendArenaButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_1"
                        style="@style/Widget.Button"
                        android:text="@string/send_arena_button" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/manualArenaContainer"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:elevation="@dimen/elevation_low">

                    <com.sc2079.group16.controller.ArenaView
                        android:id="@+id/arenaView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 2. Task 1 (Explore) Panel -->
        <LinearLayout
            android:id="@+id/panelTask1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3"
            android:orientation="vertical"
            android:layout_marginBottom="@dimen/spacing_2"
            android:visibility="gone">

            <!-- Control & Stopwatch Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/spacing_2">

                <Button
                    android:id="@+id/startTask1Button"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1.2"
                    android:text="@string/start_task1"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/task1_green"
                    android:textColor="@color/on_success" />

                <TextView
                    android:id="@+id/t1TimerText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_2"
                    android:layout_marginEnd="@dimen/spacing_2"
                    android:fontFamily="monospace"
                    android:text="@string/timer_default_t1"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/t1StateBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/shape_badge"
                    android:backgroundTint="@color/badge_idle"
                    android:paddingStart="@dimen/spacing_2"
                    android:paddingTop="3dp"
                    android:paddingEnd="@dimen/spacing_2"
                    android:paddingBottom="3dp"
                    android:text="@string/state_idle"
                    android:textColor="@color/badge_text"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Mission Telemetry Sub-strip -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/spacing_2">

                <TextView
                    android:id="@+id/t1LegText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Leg: Ready | Target: --"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/t1SensorText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="US: -- cm | IR: -- cm"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Live Arena Map in Task 1 -->
            <FrameLayout
                android:id="@+id/task1ArenaContainer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:elevation="@dimen/elevation_low" />

            <!-- Target Summary Strip -->
            <LinearLayout
                android:id="@+id/t1TargetsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_2"
                android:background="@drawable/bg_card"
                android:elevation="@dimen/elevation_low"
                android:orientation="vertical"
                android:padding="@dimen/spacing_2">

                <TextView
                    android:id="@+id/t1TargetsText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🎯 Targets: Standing by for mission start"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 3. Task 2 (Fastest Car) Panel -->
        <LinearLayout
            android:id="@+id/panelTask2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3"
            android:orientation="vertical"
            android:layout_marginBottom="@dimen/spacing_2"
            android:visibility="gone">

            <!-- Sprint Control & Stopwatch Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/spacing_2">

                <Button
                    android:id="@+id/startTask2Button"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1.2"
                    android:text="@string/start_task2"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/task2_blue"
                    android:textColor="@color/on_info" />

                <TextView
                    android:id="@+id/t2TimerText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_2"
                    android:layout_marginEnd="@dimen/spacing_2"
                    android:fontFamily="monospace"
                    android:text="@string/timer_default_t2"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/t2StateBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/shape_badge"
                    android:backgroundTint="@color/badge_idle"
                    android:paddingStart="@dimen/spacing_2"
                    android:paddingTop="3dp"
                    android:paddingEnd="@dimen/spacing_2"
                    android:paddingBottom="3dp"
                    android:text="@string/state_idle"
                    android:textColor="@color/badge_text"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Arrow Detection Cards (Obstacle 1 & Obstacle 2) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/spacing_2">

                <!-- Obstacle 1 Card -->
                <LinearLayout
                    android:id="@+id/t2Obs1Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/spacing_1"
                    android:background="@drawable/bg_card"
                    android:elevation="@dimen/elevation_low"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_2">

                    <TextView
                        style="@style/TextAppearance.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/obs1_label"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/t2Obs1Arrow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_1"
                        android:layout_marginBottom="@dimen/spacing_1"
                        android:gravity="center"
                        android:text="@string/waiting_label"
                        android:textColor="@color/text_disabled"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/t2Obs1Details"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Symbol: -- | Conf: --"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Obstacle 2 Card -->
                <LinearLayout
                    android:id="@+id/t2Obs2Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/spacing_1"
                    android:background="@drawable/bg_card"
                    android:elevation="@dimen/elevation_low"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_2">

                    <TextView
                        style="@style/TextAppearance.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/obs2_label"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/t2Obs2Arrow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_1"
                        android:layout_marginBottom="@dimen/spacing_1"
                        android:gravity="center"
                        android:text="@string/waiting_label"
                        android:textColor="@color/text_disabled"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/t2Obs2Details"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Symbol: -- | Conf: --"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Astryx Stepper: 7-Step Pipeline Stepper Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:elevation="@dimen/elevation_low"
                android:orientation="vertical"
                android:padding="@dimen/spacing_2"
                android:layout_marginBottom="@dimen/spacing_2">

                <TextView
                    android:id="@+id/t2StepTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pipeline: Ready"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="@dimen/spacing_1" />

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Step 1 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/t2Indicator1"
                                android:layout_width="@dimen/stepper_circle_size"
                                android:layout_height="@dimen/stepper_circle_size"
                                android:gravity="center"
                                android:background="@drawable/bg_stepper_circle_pending"
                                android:text="1"
                                android:textColor="@color/stepper_pending_text"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:layout_marginEnd="@dimen/spacing_2" />

                            <TextView
                                android:id="@+id/t2Step1"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Approach Obstacle 1"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="@dimen/stepper_rail_width"
                            android:layout_height="4dp"
                            android:layout_marginStart="10dp"
                            android:background="@color/stepper_rail" />

                        <!-- Step 2 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/t2Indicator2"
                                android:layout_width="@dimen/stepper_circle_size"
                                android:layout_height="@dimen/stepper_circle_size"
                                android:gravity="center"
                                android:background="@drawable/bg_stepper_circle_pending"
                                android:text="2"
                                android:textColor="@color/stepper_pending_text"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:layout_marginEnd="@dimen/spacing_2" />

                            <TextView
                                android:id="@+id/t2Step2"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Scan Arrow 1 (Left / Right)"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="@dimen/stepper_rail_width"
                            android:layout_height="4dp"
                            android:layout_marginStart="10dp"
                            android:background="@color/stepper_rail" />

                        <!-- Step 3 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/t2Indicator3"
                                android:layout_width="@dimen/stepper_circle_size"
                                android:layout_height="@dimen/stepper_circle_size"
                                android:gravity="center"
                                android:background="@drawable/bg_stepper_circle_pending"
                                android:text="3"
                                android:textColor="@color/stepper_pending_text"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:layout_marginEnd="@dimen/spacing_2" />

                            <TextView
                                android:id="@+id/t2Step3"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Slalom Obstacle 1"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="@dimen/stepper_rail_width"
                            android:layout_height="4dp"
                            android:layout_marginStart="10dp"
                            android:background="@color/stepper_rail" />

                        <!-- Step 4 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/t2Indicator4"
                                android:layout_width="@dimen/stepper_circle_size"
                                android:layout_height="@dimen/stepper_circle_size"
                                android:gravity="center"
                                android:background="@drawable/bg_stepper_circle_pending"
                                android:text="4"
                                android:textColor="@color/stepper_pending_text"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:layout_marginEnd="@dimen/spacing_2" />

                            <TextView
                                android:id="@+id/t2Step4"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Approach Obstacle 2"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="@dimen/stepper_rail_width"
                            android:layout_height="4dp"
                            android:layout_marginStart="10dp"
                            android:background="@color/stepper_rail" />

                        <!-- Step 5 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/t2Indicator5"
                                android:layout_width="@dimen/stepper_circle_size"
                                android:layout_height="@dimen/stepper_circle_size"
                                android:gravity="center"
                                android:background="@drawable/bg_stepper_circle_pending"
                                android:text="5"
                                android:textColor="@color/stepper_pending_text"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:layout_marginEnd="@dimen/spacing_2" />

                            <TextView
                                android:id="@+id/t2Step5"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Scan Arrow 2 (Left / Right)"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="@dimen/stepper_rail_width"
                            android:layout_height="4dp"
                            android:layout_marginStart="10dp"
                            android:background="@color/stepper_rail" />

                        <!-- Step 6 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/t2Indicator6"
                                android:layout_width="@dimen/stepper_circle_size"
                                android:layout_height="@dimen/stepper_circle_size"
                                android:gravity="center"
                                android:background="@drawable/bg_stepper_circle_pending"
                                android:text="6"
                                android:textColor="@color/stepper_pending_text"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:layout_marginEnd="@dimen/spacing_2" />

                            <TextView
                                android:id="@+id/t2Step6"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Round Obs 2 &amp; Return Loop"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="@dimen/stepper_rail_width"
                            android:layout_height="4dp"
                            android:layout_marginStart="10dp"
                            android:background="@color/stepper_rail" />

                        <!-- Step 7 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/t2Indicator7"
                                android:layout_width="@dimen/stepper_circle_size"
                                android:layout_height="@dimen/stepper_circle_size"
                                android:gravity="center"
                                android:background="@drawable/bg_stepper_circle_pending"
                                android:text="7"
                                android:textColor="@color/stepper_pending_text"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:layout_marginEnd="@dimen/spacing_2" />

                            <TextView
                                android:id="@+id/t2Step7"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Carpark Sprint &amp; Finish"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>
                </ScrollView>
            </LinearLayout>

            <!-- Sensor and Maneuver Row -->
            <LinearLayout
                android:id="@+id/t2SensorRowCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:elevation="@dimen/elevation_low"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_2">

                <TextView
                    android:id="@+id/t2SensorText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:text="Ultrasonic: -- cm"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/t2ManeuverText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="Maneuver: Ready"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Global Control Buttons (STOP & Reset) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="@dimen/spacing_2">

            <Button
                android:id="@+id/stopButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                style="@style/Widget.Button.Danger"
                android:text="@string/stop_button"
                android:layout_marginEnd="@dimen/spacing_1" />

            <Button
                android:id="@+id/resetButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="@style/Widget.Button.Secondary"
                android:text="@string/reset_button"
                android:layout_marginStart="@dimen/spacing_1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/status_label"
                style="@style/TextAppearance.Label"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/verbose_log_label"
                style="@style/TextAppearance.Label"
                android:textSize="11sp"
                android:layout_marginEnd="@dimen/spacing_1" />

            <Switch
                android:id="@+id/verboseLogSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_2" />

            <Button
                android:id="@+id/clearLogsButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Widget.Button.Secondary"
                android:text="@string/clear_logs_button" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/statusScrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card"
            android:padding="@dimen/spacing_2"
            android:clipToPadding="false"
            android:elevation="@dimen/elevation_low">

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:fontFamily="monospace"
                android:textSize="13sp" />
        </ScrollView>
    </LinearLayout>

</LinearLayout>
