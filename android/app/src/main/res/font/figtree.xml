<?xml version="1.0" encoding="utf-8"?>
<!-- Figtree, OFL-licensed (figtree.ttf), matching astryx's neutral theme's
     typography.body/heading family. Loaded as a variable font pinned to its
     regular (400) weight instance, see figtree_bold.xml for the 700 cut. -->
