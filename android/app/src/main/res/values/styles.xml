<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">@font/figtree</item>
    </style>

    <style name="Widget.Button" parent="android:Widget.Material.Button">
        <item name="android:fontFamily">@font/figtree</item>
        <item name="android:background">@drawable/ripple_button_primary</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:elevation">2dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.Button.Secondary">
        <item name="android:background">@drawable/ripple_button_secondary</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="Widget.Button.Danger">
        <item name="android:background">@drawable/ripple_button_danger</item>
        <item name="android:textColor">@color/on_error</item>
    </style>

    <style name="TextAppearance.Heading" parent="">
        <item name="android:fontFamily">@font/figtree_bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Label" parent="">
        <item name="android:textColor">@color/text_secondary</item>
    </style>
</resources>
