<resources>
    <!-- Radius scale ported from facebook/astryx's "neutral" theme
         (packages/themes/neutral/src/neutralTheme.ts, the radius token family).
         Astryx's rem values assume a 16px root, so 1rem == 16dp here. -->
    <dimen name="radius_inner">6dp</dimen>     <!-- 0.375rem -->
    <dimen name="radius_element">10dp</dimen>  <!-- 0.625rem: buttons -->
    <dimen name="radius_container">12dp</dimen> <!-- 0.75rem: cards/panels -->
    <dimen name="radius_page">28dp</dimen>     <!-- 1.75rem -->
</resources>
