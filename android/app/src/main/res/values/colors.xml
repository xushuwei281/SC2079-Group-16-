<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light-mode palette ported from facebook/astryx's "neutral" theme
         (packages/themes/neutral/src/neutralTheme.ts). Dark-mode values
         live in values-night/colors.xml, Android's day/night resource
         system picks between them automatically, matching Astryx's own
         [light, dark] token tuples exactly. -->

    <!-- Background -->
    <color name="background_body">#F1F1F1</color>
    <color name="background_surface">#FFFFFF</color>
    <color name="background_card">#FFFFFF</color>
    <color name="background_popover">#FFFFFF</color>
    <color name="background_muted">#F1F1F1</color>

    <!-- Text -->
    <color name="text_primary">#171717</color>
    <color name="text_secondary">#525252</color>
    <color name="text_disabled">#A3A3A3</color>
    <color name="text_accent">#262626</color>

    <!-- Neutral accent (near-black in light mode, near-white in dark),
         used for primary buttons and general emphasis. -->
    <color name="accent">#262626</color>
    <color name="accent_muted">#F1F1F1</color>
    <color name="on_accent">#FFFFFF</color>

    <!-- Border -->
    <color name="border">#14000000</color>
    <color name="border_emphasized">#D4D4D4</color>
    <color name="border_subtle">#E5E5E5</color>

    <!-- Astryx Status System -->
    <color name="status_accent_fill">#0074E2</color>
    <color name="status_accent_subtle">#DBEAFE</color>
    <color name="on_info">#FFFFFF</color>

    <color name="status_error_fill">#C9303A</color>
    <color name="status_error_subtle">#FEE2E2</color>
    <color name="on_error">#FFFFFF</color>

    <color name="status_success_fill">#007004</color>
    <color name="status_success_subtle">#DCFCE7</color>
    <color name="on_success">#FFFFFF</color>

    <color name="status_warning_fill">#B45309</color>
    <color name="status_warning_subtle">#FEF3C7</color>
    <color name="on_warning">#FFFFFF</color>

    <!-- Categorical: orange, used for obstacle markers -->
    <color name="categorical_orange_icon">#6E3500</color>
    <color name="categorical_orange_bg">#FAD0B5</color>

    <!-- Astryx Segmented Control & Tabs -->
    <color name="segmented_track_bg">#E5E5E5</color>
    <color name="segmented_thumb_bg">#262626</color>
    <color name="segmented_thumb_text">#FFFFFF</color>
    <color name="segmented_unselected_text">#525252</color>

    <!-- Astryx Stepper Tokens -->
    <color name="stepper_pending_bg">#E5E5E5</color>
    <color name="stepper_pending_text">#737373</color>
    <color name="stepper_active_bg">#0074E2</color>
    <color name="stepper_active_text">#FFFFFF</color>
    <color name="stepper_completed_bg">#007004</color>
    <color name="stepper_completed_text">#FFFFFF</color>
    <color name="stepper_rail">#D4D4D4</color>

    <!-- Astryx Chip Tokens -->
    <color name="chip_bg">#F1F1F1</color>
    <color name="chip_bg_selected">#262626</color>
    <color name="chip_text">#171717</color>
    <color name="chip_text_selected">#FFFFFF</color>

    <!-- Legacy aliases mapped to Astryx tokens for backwards compatibility -->
    <color name="background">@color/background_body</color>
    <color name="status_background">@color/background_card</color>
    <color name="stop_red">@color/status_error_fill</color>
    <color name="task1_green">@color/status_success_fill</color>
    <color name="task2_blue">@color/status_accent_fill</color>
    <color name="reset_gray">@color/accent</color>
    <color name="tab_active">@color/segmented_thumb_bg</color>
    <color name="tab_inactive">@color/segmented_track_bg</color>
    <color name="card_background">@color/background_surface</color>

    <!-- Telemetry Badges and Indicators -->
    <color name="badge_text">#FFFFFF</color>
    <color name="badge_idle">@color/text_secondary</color>
    <color name="badge_active">@color/status_accent_fill</color>
    <color name="badge_warning">@color/status_warning_fill</color>
    <color name="badge_success">@color/status_success_fill</color>
    <color name="badge_estop">@color/status_error_fill</color>
    <color name="arrow_left">@color/status_success_fill</color>
    <color name="arrow_right">@color/status_accent_fill</color>
</resources>
