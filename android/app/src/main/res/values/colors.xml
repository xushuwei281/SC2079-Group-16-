<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light-mode palette ported from facebook/astryx's "neutral" theme
         (packages/themes/neutral/src/neutralTheme.ts). Dark-mode values
         live in values-night/colors.xml, Android's day/night resource
         system picks between them automatically, matching Astryx's own
         [light, dark] token tuples exactly. -->

    <!-- Background -->
    <color name="background_body">#F1F1F1</color>
    <color name="background_surface">#FFFFFF</color>
    <color name="background_card">#FFFFFF</color>

    <!-- Text -->
    <color name="text_primary">#171717</color>
    <color name="text_secondary">#525252</color>
    <color name="text_disabled">#A3A3A3</color>

    <!-- Neutral accent (near-black in light mode, near-white in dark),
         used for primary buttons and general emphasis. -->
    <color name="accent">#262626</color>
    <color name="on_accent">#FFFFFF</color>

    <!-- Border -->
    <color name="border">#14000000</color>
    <color name="border_emphasized">#D4D4D4</color>

    <!-- Status fills (solid-fill button/marker colors) -->
    <color name="status_accent_fill">#0074E2</color> <!-- reserved for live/info markers -->
    <color name="status_error_fill">#C9303A</color>
    <color name="on_error">#FFFFFF</color>

    <!-- Categorical: orange, used for obstacle markers -->
    <color name="categorical_orange_icon">#6E3500</color>
    <color name="categorical_orange_bg">#FAD0B5</color>

    <!-- Legacy names kept as aliases, still referenced by the Task 1/Task 2
         panels added in 0c3a9fb. Point at the astryx-derived tokens above
         rather than diverging with separate hardcoded values. -->
    <color name="background">@color/background_body</color>
    <color name="status_background">@color/background_card</color>
    <color name="stop_red">@color/status_error_fill</color>

    <!-- Task 1 / Task 2 mode-panel colors -->
    <color name="task1_green">#2E7D32</color>
    <color name="task2_blue">#1565C0</color>
    <color name="reset_gray">#546E7A</color>
    <color name="tab_active">#1976D2</color>
    <color name="tab_inactive">#CFD8DC</color>
    <color name="card_background">#F5F5F5</color>

    <!-- Telemetry Badges and Indicators -->
    <color name="badge_idle">#546E7A</color>
    <color name="badge_active">#0074E2</color>
    <color name="badge_warning">#E65100</color>
    <color name="badge_success">#2E7D32</color>
    <color name="badge_estop">#C9303A</color>
    <color name="arrow_left">#2E7D32</color>
    <color name="arrow_right">#1565C0</color>
</resources>
