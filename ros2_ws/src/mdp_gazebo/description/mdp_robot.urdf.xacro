<?xml version="1.0"?>
<!--
SC2079 MDP robot description for Gazebo (gz-sim / Harmonic via ros_gz).

Chassis/wheel/caster visuals come from Wheeltec's mini_diff_robot_meshes
(meshes/*.STL, provided by the user from a local wheeltec_robot_urdf copy) —
a differential-drive base in the same size class as the real robot, used here
for visualization only. No matching license file shipped with the source
package (its package.xml has a "TODO: License declaration"); confirm terms
before distributing this repo outside the team.

Numbers actually driving the physics (and therefore what matters for
sim-to-real fidelity):
  - wheel_radius / wheel_width: measured from left_link.STL / right_link.STL's
    own bounding box (66.36mm diameter, 28.6mm wide) — there is no wheel
    diameter constant anywhere else in this repo, so this mesh is the only
    source for it.
  - wheel_separation (0.15m): ros2_ws/docs/stm32-uart-protocol-spec.md's
    150mm track width — independently corroborated by base_link.STL's own
    footprint width (153.6mm), so no rescaling was needed.
  - Chassis COLLISION box uses the real footprint from algorithm/arena.py
    (ROBOT_W_CM=19, ROBOT_H_CM=23), which is why it doesn't exactly match the
    mesh's native bounding box (153.6mm x 229.6mm) — the mesh is a stand-in
    visual, the collision box is what the physics engine (and any future
    collision checks) actually see.
  - Chassis/caster height and caster ground-contact position are visual
    estimates (no height spec exists anywhere in the repo) placed to keep the
    mesh's wheels flush with the ground plane; they don't affect the
    differential-drive kinematics, only how the robot looks/balances in sim.
-->
<robot name="mdp_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="wheel_radius" value="0.0332"/>
  <xacro:property name="wheel_width" value="0.0286"/>
  <xacro:property name="wheel_separation" value="0.15"/>
  <xacro:property name="caster_radius" value="0.0303"/>
  <xacro:property name="caster_x" value="0.095"/>
  <xacro:property name="caster_z" value="${-(wheel_radius - caster_radius)}"/>

  <!-- Real robot footprint (algorithm/arena.py: ROBOT_H_CM x ROBOT_W_CM), in metres -->
  <xacro:property name="chassis_length" value="0.23"/>
  <xacro:property name="chassis_width" value="0.19"/>
  <xacro:property name="chassis_height" value="0.055"/>
  <xacro:property name="chassis_x_offset" value="0.0142"/>
  <xacro:property name="chassis_z_offset" value="0.024"/>

  <material name="mdp_grey">
    <color rgba="0.55 0.55 0.58 1.0"/>
  </material>
  <material name="mdp_dark">
    <color rgba="0.12 0.12 0.13 1.0"/>
  </material>

  <link name="base_footprint"/>

  <!-- base_link origin = drive-wheel axle centre (matches the source mesh's own frame) -->
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mdp_gazebo/meshes/base_link.STL"/>
      </geometry>
      <material name="mdp_grey"/>
    </visual>
    <collision>
      <origin xyz="${chassis_x_offset} 0 ${chassis_z_offset}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="${chassis_x_offset} 0 ${chassis_z_offset}" rpy="0 0 0"/>
      <mass value="1.2"/>
      <inertia ixx="0.006" ixy="0" ixz="0" iyy="0.008" iyz="0" izz="0.010"/>
    </inertial>
  </link>

  <xacro:macro name="wheel" params="prefix reflect mesh_file">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://mdp_gazebo/meshes/${mesh_file}"/>
        </geometry>
        <material name="mdp_dark"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.05"/>
        <inertia ixx="2.0e-5" ixy="0" ixz="0" iyy="2.0e-5" iyz="0" izz="3.0e-5"/>
      </inertial>
    </link>
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="0 ${reflect * wheel_separation / 2} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel prefix="left" reflect="1" mesh_file="left_link.STL"/>
  <xacro:wheel prefix="right" reflect="-1" mesh_file="right_link.STL"/>

  <!-- Passive caster: free-rolling contact point, not part of the diff-drive kinematics -->
  <link name="caster_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mdp_gazebo/meshes/front_link.STL"/>
      </geometry>
      <material name="mdp_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="1.0e-6" ixy="0" ixz="0" iyy="1.0e-6" iyz="0" izz="1.0e-6"/>
    </inertial>
  </link>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="${caster_x} 0 ${caster_z}" rpy="0 0 0"/>
  </joint>

  <!-- Sensor link placeholders — same offsets from base_link as the static TFs
       robot.launch.py publishes on the real robot (ros2_ws/src/mdp_bringup/launch/robot.launch.py),
       so RViz/Foxglove layouts built against hardware line up in sim too. No
       sensors are actually simulated here yet; sim_bridge_node publishes
       always-clear Range stubs on these frames (see its module docstring). -->
  <link name="ultrasonic_link"/>
  <joint name="ultrasonic_joint" type="fixed">
    <parent link="base_link"/>
    <child link="ultrasonic_link"/>
    <origin xyz="0.10 0.0 0.05" rpy="0 0 0"/>
  </joint>
  <link name="ir_left_link"/>
  <joint name="ir_left_joint" type="fixed">
    <parent link="base_link"/>
    <child link="ir_left_link"/>
    <origin xyz="0.08 0.06 0.04" rpy="0 0 0.52"/>
  </joint>
  <link name="ir_right_link"/>
  <joint name="ir_right_joint" type="fixed">
    <parent link="base_link"/>
    <child link="ir_right_link"/>
    <origin xyz="0.08 -0.06 0.04" rpy="0 0 -0.52"/>
  </joint>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <min_linear_acceleration>-1.0</min_linear_acceleration>
      <max_angular_acceleration>4.0</max_angular_acceleration>
      <min_angular_acceleration>-4.0</min_angular_acceleration>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>20</odom_publish_frequency>
      <publish_odom>true</publish_odom>
      <publish_tf>false</publish_tf>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher"/>
  </gazebo>

</robot>
