<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mdp_gazebo</name>
  <version>0.0.1</version>
  <description>Gazebo (gz-sim) simulation of the SC2079 MDP robot: world, robot description, and a sim-to-hardware-bridge node that mimics serial_bridge_node's /robot_pose and sensor topics so the real planner/motion_controller run unmodified against the simulated robot</description>
  <maintainer email="frieddeli@gmail.com">Ray Shao</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>tf2_ros</depend>
  <depend>xacro</depend>
  <depend>robot_state_publisher</depend>
  <depend>ros_gz_sim</depend>
  <depend>ros_gz_bridge</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>mdp_hardware_bridge</exec_depend>
  <exec_depend>mdp_bringup</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
