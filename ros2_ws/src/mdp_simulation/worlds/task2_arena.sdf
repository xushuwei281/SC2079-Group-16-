<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="mdp_task2_arena">
    <physics name="1ms" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>1.0 1.0 10.0 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.15 -0.15 -1.0</direction>
    </light>

    <scene>
      <ambient>0.65 0.65 0.65 1.0</ambient>
      <background>0.82 0.86 0.90 1.0</background>
      <shadows>true</shadows>
    </scene>

    <!-- Floor (2.0m x 2.0m with 10cm grid lines and 40cm start carpark) -->
    <model name="arena_floor">
      <static>true</static>
      <link name="floor_link">
        <collision name="floor_collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>10.0 10.0</size></plane>
          </geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="arena_surface">
          <pose>1.0 1.0 0.0005 0 0 0</pose>
          <geometry><box><size>2.0 2.0 0.001</size></box></geometry>
          <material>
            <ambient>0.96 0.96 0.96 1</ambient><diffuse>0.96 0.96 0.96 1</diffuse>
            <pbr><metal><albedo_map>materials/textures/arena_grid.png</albedo_map></metal></pbr>
          </material>
        </visual>
        <visual name="start_zone_carpark">
          <pose>0.20 0.20 0.0012 0 0 0</pose>
          <geometry><box><size>0.40 0.40 0.0005</size></box></geometry>
          <material><ambient>0.25 0.85 0.25 0.6</ambient><diffuse>0.25 0.85 0.25 0.6</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Perimeter Boundary (2.0m x 2.0m, height 0.05m = 5cm, thickness 0.02m) -->
    <model name="boundary_walls">
      <static>true</static>
      <link name="walls_link">
        <collision name="south_wall_col"><pose>1.0 -0.01 0.025 0 0 0</pose><geometry><box><size>2.04 0.02 0.05</size></box></geometry></collision>
        <visual name="south_wall_vis"><pose>1.0 -0.01 0.025 0 0 0</pose><geometry><box><size>2.04 0.02 0.05</size></box></geometry><material><ambient>0.85 0.85 0.88 1</ambient><diffuse>0.85 0.85 0.88 1</diffuse></material></visual>

        <collision name="north_wall_col"><pose>1.0 2.01 0.025 0 0 0</pose><geometry><box><size>2.04 0.02 0.05</size></box></geometry></collision>
        <visual name="north_wall_vis"><pose>1.0 2.01 0.025 0 0 0</pose><geometry><box><size>2.04 0.02 0.05</size></box></geometry><material><ambient>0.85 0.85 0.88 1</ambient><diffuse>0.85 0.85 0.88 1</diffuse></material></visual>

        <collision name="west_wall_col"><pose>-0.01 1.0 0.025 0 0 0</pose><geometry><box><size>0.02 2.04 0.05</size></box></geometry></collision>
        <visual name="west_wall_vis"><pose>-0.01 1.0 0.025 0 0 0</pose><geometry><box><size>0.02 2.04 0.05</size></box></geometry><material><ambient>0.85 0.85 0.88 1</ambient><diffuse>0.85 0.85 0.88 1</diffuse></material></visual>

        <collision name="east_wall_col"><pose>2.01 1.0 0.025 0 0 0</pose><geometry><box><size>0.02 2.04 0.05</size></box></geometry></collision>
        <visual name="east_wall_vis"><pose>2.01 1.0 0.025 0 0 0</pose><geometry><box><size>0.02 2.04 0.05</size></box></geometry><material><ambient>0.85 0.85 0.88 1</ambient><diffuse>0.85 0.85 0.88 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ================= TASK 2 (FASTEST CAR SPRINT) OBSTACLES ================= -->
    <!-- Per MDP Briefing Slide 16-17: 2 obstacles directly in front of carpark lane, 60cm apart -->

    <!-- Obstacle 1: Center (0.20m, 0.90m), Target Face South with Left Arrow (Symbol 39) -->
    <model name="task2_obs_1">
      <static>true</static>
      <pose>0.20 0.90 0.10 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.10 0.10 0.20</size></box></geometry></collision>
        <visual name="block_body"><geometry><box><size>0.10 0.10 0.20</size></box></geometry><material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
        <!-- Target Face (South: facing the oncoming car): Left Arrow -->
        <visual name="target_face_arrow_left">
          <pose>0 -0.051 0 1.570796 0 3.14159</pose>
          <geometry><box><size>0.08 0.08 0.002</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse>
            <pbr><metal><albedo_map>materials/textures/target_arrow_left.png</albedo_map></metal></pbr>
          </material>
        </visual>
        <!-- Bullseye on North, East, West -->
        <visual name="bullseye_north"><pose>0 0.051 0 1.570796 0 0</pose><geometry><box><size>0.08 0.08 0.002</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>materials/textures/bullseye.png</albedo_map></metal></pbr></material></visual>
        <visual name="bullseye_east"><pose>0.051 0 0 0 1.570796 0</pose><geometry><box><size>0.08 0.08 0.002</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>materials/textures/bullseye.png</albedo_map></metal></pbr></material></visual>
        <visual name="bullseye_west"><pose>-0.051 0 0 0 1.570796 3.14159</pose><geometry><box><size>0.08 0.08 0.002</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>materials/textures/bullseye.png</albedo_map></metal></pbr></material></visual>
      </link>
    </model>

    <!-- Obstacle 2: Center (0.20m, 1.50m) (60cm behind Obs 1), Target Face South with Right Arrow (Symbol 38) -->
    <model name="task2_obs_2">
      <static>true</static>
      <pose>0.20 1.50 0.10 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.10 0.10 0.20</size></box></geometry></collision>
        <visual name="block_body"><geometry><box><size>0.10 0.10 0.20</size></box></geometry><material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
        <!-- Target Face (South): Right Arrow -->
        <visual name="target_face_arrow_right">
          <pose>0 -0.051 0 1.570796 0 3.14159</pose>
          <geometry><box><size>0.08 0.08 0.002</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse>
            <pbr><metal><albedo_map>materials/textures/target_arrow_right.png</albedo_map></metal></pbr>
          </material>
        </visual>
        <!-- Bullseye on North, East, West -->
        <visual name="bullseye_north"><pose>0 0.051 0 1.570796 0 0</pose><geometry><box><size>0.08 0.08 0.002</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>materials/textures/bullseye.png</albedo_map></metal></pbr></material></visual>
        <visual name="bullseye_east"><pose>0.051 0 0 0 1.570796 0</pose><geometry><box><size>0.08 0.08 0.002</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>materials/textures/bullseye.png</albedo_map></metal></pbr></material></visual>
        <visual name="bullseye_west"><pose>-0.051 0 0 0 1.570796 3.14159</pose><geometry><box><size>0.08 0.08 0.002</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>materials/textures/bullseye.png</albedo_map></metal></pbr></material></visual>
      </link>
    </model>

  </world>
</sdf>
