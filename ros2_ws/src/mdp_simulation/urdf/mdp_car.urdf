  <!-- ================= SENSORS ================= -->
  <!-- 1. Raspberry Pi Camera Module v2.1                                -->
  <!-- As documented in SC2079 Robotcar2022 Layout.pdf Fig 8:             -->
  <!-- • Mounted on two brass hex pillars on the top plate at X = 0.045 m  -->
  <!-- • Located directly in front of the STM32/Pi tower, facing forward   -->
  <!-- • Lens optical height at Z ≈ 0.075 m (world height ≈ 9.2 cm)        -->
  <link name="camera_link">
    <!-- Camera PCB -->
    <visual name="camera_pcb">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.003 0.025 0.024"/>
      </geometry>
      <material name="sensor_blue"/>
    </visual>
    <!-- Camera Lens Barrel -->
    <visual name="camera_lens">
      <origin rpy="0 1.57079632679 0" xyz="0.003 0 0"/>
      <geometry>
        <cylinder length="0.006" radius="0.004"/>
      </geometry>
      <material name="tire_rubber"/>
    </visual>
    <!-- Left Brass Standoff Pillar -->
    <visual name="camera_standoff_left">
      <origin rpy="0 0 0" xyz="0 0.010 -0.012"/>
      <geometry>
        <cylinder length="0.024" radius="0.002"/>
      </geometry>
      <material name="gold_accent"/>
    </visual>
    <!-- Right Brass Standoff Pillar -->
    <visual name="camera_standoff_right">
      <origin rpy="0 0 0" xyz="0 -0.010 -0.012"/>
      <geometry>
        <cylinder length="0.024" radius="0.002"/>
      </geometry>
      <material name="gold_accent"/>
    </visual>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <!-- Positioned on base_link top plate directly in front of STM32/Pi tower -->
    <origin rpy="0 0 0" xyz="0.0450 0 0.0755"/>
  </joint>
  <!-- camera_optical_link: ROS camera frame (Z forward, X right, Y down) -->
  <link name="camera_optical_link"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_link"/>
    <origin rpy="-1.57079632679 0 -1.57079632679" xyz="0.006 0 0"/>
  </joint>
  <gazebo reference="camera_link">
    <sensor name="front_camera" type="camera">
      <pose>0 0 0 0 0 0</pose>
      <always_on>1</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
      <topic>/camera/image_raw</topic>
      <camera>
        <horizontal_fov>1.0855</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>8.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>
  <!-- 2. Front Ultrasonic Rangefinder (HC-SR04) -->
  <link name="ultrasonic_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.01" radius="0.008"/>
      </geometry>
      <material name="sensor_blue"/>
    </visual>
  </link>
  <joint name="ultrasonic_joint" type="fixed">
    <parent link="base_link"/>
    <child link="ultrasonic_link"/>
    <origin rpy="0 0 0" xyz="0.115 0 0.020"/>
  </joint>
  <gazebo reference="ultrasonic_link">
    <sensor name="ultrasonic" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <always_on>1</always_on>
      <update_rate>20</update_rate>
      <visualize>false</visualize>
      <topic>/model/mdp_car/sensors/ultrasonic</topic>
      <lidar>
        <scan>
          <horizontal>
            <samples>5</samples>
            <resolution>1</resolution>
            <min_angle>-0.13</min_angle>
            <max_angle>0.13</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.02</min>
          <max>3.00</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>
  <!-- 3. Dual Sharp GP2Y0A21YK IR Sensors (angled outward at front corners) -->
  <link name="ir_left_link">
    <visual>
      <geometry>
        <box size="0.01 0.01 0.01"/>
      </geometry>
      <material name="sensor_blue"/>
    </visual>
  </link>
  <joint name="ir_left_joint" type="fixed">
