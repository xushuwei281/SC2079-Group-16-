    <child link="rear_right_wheel_link"/>
    <origin rpy="0 0 0" xyz="-0.06966 -0.0800 0.0162"/>
    <axis xyz="0 1 0"/>
  </joint>
  <!-- =============================================================== -->
  <!-- FRONT STEERING KNUCKLES + WHEELS                                -->
  <!-- Kingpin hole centres measured by circle fit (r=1.5 mm) on       -->
  <!-- base_link at Z = 0 and Z = 0.024 m planes:                      -->
  <!--   X = 0.0734 m,  Y = ±0.0520 m                                  -->
  <!-- left_link height = 0.022 m (local Z = [−0.022, 0]).             -->
  <!-- Steer joint Z set so that the spindle axle (Z_local = −0.011 m) -->
  <!-- maps to world Z = 0.01620 m (same height as rear axle):         -->
  <!--   z_steer = 0.01620 + 0.011 = 0.02720 m                         -->
  <!-- Front wheel Y offset from knuckle:                              -->
  <!--   Y = +0.028 m  →  spindle tip_local = 0.0319−0.028 = +0.0039  -->
  <!--   (inside lf_link outer face 0.01257 ✓, no protrusion)          -->
  <!-- World wheel Y = 0.0520 + 0.0280 = 0.0800 m = rear track ✓      -->
  <!-- =============================================================== -->
  <!-- Front Left Steer Knuckle -->
  <link name="front_left_steer_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://mdp_simulation/meshes/mini_akm_robot_meshes/left_link.STL"/>
      </geometry>
      <material name="gold_accent"/>
    </visual>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="0.000010" ixy="0" ixz="0" iyy="0.000010" iyz="0" izz="0.000010"/>
    </inertial>
  </link>
  <joint name="front_left_steer_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_left_steer_link"/>
    <!-- X, Y from circle fit on base_link; Z so axle sits at world Z = axle_z -->
    <origin rpy="0 0 0" xyz="0.0734 0.0520 0.02720"/>
    <axis xyz="0 0 1"/>
    <limit effort="10.0" lower="-0.52" upper="0.52" velocity="4.0"/>
  </joint>
  <!-- Front Left Wheel -->
  <link name="front_left_wheel_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://mdp_simulation/meshes/mini_akm_robot_meshes/lf_link.STL"/>
      </geometry>
      <material name="tire_rubber"/>
    </visual>
    <collision>
      <origin rpy="1.5707963268 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.026" radius="0.0332"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.08"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="2.655146666666667e-05" ixy="0.0" ixz="0.0" iyy="4.40896e-05" iyz="0.0" izz="2.655146666666667e-05"/>
    </inertial>
  </link>
  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="front_left_steer_link"/>
    <child link="front_left_wheel_link"/>
    <!-- In left_link frame: spindle at X=0, Z=−0.011; Y=+0.028 seats hub over spindle -->
    <origin rpy="0 0 0" xyz="0 0.0280 -0.0110"/>
    <axis xyz="0 1 0"/>
  </joint>
  <!-- Front Right Steer Knuckle -->
  <link name="front_right_steer_link">
