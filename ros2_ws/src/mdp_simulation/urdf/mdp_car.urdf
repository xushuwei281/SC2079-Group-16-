<robot name="mdp_car">
  <!-- ================= PHYSICAL SPECIFICATIONS ================= -->
  <!-- Wheeltec Mini-Ackermann Robot (SC2079 Course Hardware)     -->
  <!-- All values derived from vertex analysis of the 11 STL meshes in  -->
  <!-- /SC2079 Technical Materials/URDF/wheeltec_robot_urdf/meshes/mini_akm_robot_meshes/ -->
  <!-- kg – chassis + battery + motors -->
  <!-- Materials -->
  <material name="aluminum_plate">
    <color rgba="0.75 0.76 0.78 1.0"/>
  </material>
  <material name="acrylic_deck">
    <color rgba="0.12 0.12 0.14 0.95"/>
  </material>
  <material name="tire_rubber">
    <color rgba="0.15 0.15 0.15 1.0"/>
  </material>
  <material name="sensor_blue">
    <color rgba="0.10 0.35 0.75 1.0"/>
  </material>
  <material name="gold_accent">
    <color rgba="0.95 0.75 0.15 1.0"/>
  </material>
  <!-- ================= BASE FOOTPRINT ================= -->
  <!-- base_footprint: ground plane, geometrically centred under both axles -->
  <link name="base_footprint"/>
  <!-- base_link origin = axle height above ground (0.0170 m = wheel_radius − axle_z).    -->
  <!-- base_link.STL is modelled with its origin at the motor-shaft / bracket plane.       -->
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin rpy="0 0 0" xyz="0 0 0.017"/>
  </joint>
  <!-- ================= BASE LINK ================= -->
  <link name="base_link">
    <!-- Real Wheeltec Mini-Ackermann aluminum chassis + gearbox assembly -->
    <visual name="chassis_cad">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://mdp_simulation/meshes/mini_akm_robot_meshes/base_link.STL"/>
      </geometry>
      <material name="aluminum_plate"/>
    </visual>
    <!-- Raspberry Pi 4 + STM32F407 2-tier stacked controller tower        -->
    <!-- Geometry & alignment derivation:                                   -->
    <!-- • In CAD (controller_link.STL), the assembly orientation matches    -->
    <!--   the chassis (rpy="0 0 0"), but the CAD datum was set to the      -->
    <!--   left edge (Y in [-0.0027, +0.0763] m).                           -->
    <!-- • The true centroid of the 79 mm acrylic deck plate is Y = +0.0368 m-->
    <!-- • Offset dY = -0.0368 m centers the acrylic deck and board body     -->
    <!--   symmetrically on the chassis centerline (Y = 0) with identical   -->
    <!--   37.3 mm left and right clearances to the aluminum chassis edges.  -->
    <!-- • Offset dZ = +0.0515 m places the standoff bottoms flush on top    -->
    <!--   of the upper aluminum chassis plate.                              -->
    <!-- • X = 0.0 m preserves CAD longitudinal positioning (X in [-0.098,  -->
    <!--   +0.002] m), placing the stack squarely over the rear drive axle   -->
    <!--   with 2.4 mm clearance to the rear chassis edge.                   -->
    <visual name="controller_deck">
      <origin rpy="0 0 0" xyz="0 -0.0368 0.0515"/>
      <geometry>
        <mesh filename="package://mdp_simulation/meshes/mini_akm_robot_meshes/controller_link.STL"/>
      </geometry>
      <material name="acrylic_deck"/>
    </visual>
    <!-- Front bumper bar / servo arm (front_link.STL)                -->
    <!-- front_link local X=[−0.031,+0.025], front face at X=+0.025.  -->
    <!-- base_link front nose at X=+0.129.                             -->
    <!-- Offset = 0.129 − 0.025 = 0.104 → flush to the nose.          -->
    <visual name="front_bumper">
      <origin rpy="0 0 0" xyz="0.104 0 0"/>
      <geometry>
        <mesh filename="package://mdp_simulation/meshes/mini_akm_robot_meshes/front_link.STL"/>
      </geometry>
      <material name="gold_accent"/>
    </visual>
    <!-- Narrow chassis collision box: never overlaps any wheel cylinder.              -->
    <!-- 210 mm long, 100 mm wide (12 mm inside each wheel face), 50 mm tall.         -->
    <collision name="chassis_collision">
      <origin rpy="0 0 0" xyz="0 0 0.022"/>
      <geometry>
        <box size="0.21 0.10 0.05"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0.01"/>
      <mass value="1.6"/>
      <inertia ixx="0.0042" ixy="0.0" ixz="0.0" iyy="0.0078" iyz="0.0" izz="0.0105"/>
    </inertial>
  </link>
  <gazebo reference="base_link">
    <self_collide>false</self_collide>
    <material>
      <ambient>0.20 0.20 0.25 1.0</ambient>
      <diffuse>0.60 0.62 0.65 1.0</diffuse>
      <specular>0.70 0.70 0.70 1.0</specular>
    </material>
  </gazebo>
  <!-- =============================================================== -->
  <!-- REAR WHEELS                                                      -->
  <!-- Motor shaft axis measured by STL cylinder fit (var = 2e-11 m²): -->
  <!--   X = −0.06966 m,  Z = +0.01620 m                               -->
  <!-- Wheel hub bore: Y_inner = −0.01603 m, Y_outer = +0.00358 m      -->
  <!-- Y_joint chosen so:                                               -->
  <!--   • shaft tip lands at Y_local = 0.07679 − Y_joint  (inside bore ✓) -->
  <!--   • inner hub face clears chassis wall at Y ≈ 0.063 m           -->
  <!--   • track width = 2 × Y_joint = 0.160 m  (matches front)        -->
  <!-- Y_joint = 0.0800 m  →  tip_local = −0.0032 m  (bore valid ✓)    -->
  <!-- =============================================================== -->
  <!-- Rear Left Wheel -->
  <link name="rear_left_wheel_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://mdp_simulation/meshes/mini_akm_robot_meshes/lb_link.STL"/>
      </geometry>
      <material name="tire_rubber"/>
    </visual>
    <collision>
      <!-- rotate cylinder so its axis aligns with Y (spinning axis) -->
      <origin rpy="1.5707963268 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.026" radius="0.0332"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.08"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="2.655146666666667e-05" ixy="0.0" ixz="0.0" iyy="4.40896e-05" iyz="0.0" izz="2.655146666666667e-05"/>
    </inertial>
  </link>
  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel_link"/>
    <!-- X, Z from STL cylinder fit; Y=+0.080 m gives track width 160 mm -->
    <origin rpy="0 0 0" xyz="-0.06966 0.0800 0.0162"/>
    <axis xyz="0 1 0"/>
  </joint>
  <!-- Rear Right Wheel -->
  <link name="rear_right_wheel_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://mdp_simulation/meshes/mini_akm_robot_meshes/rb_link.STL"/>
      </geometry>
      <material name="tire_rubber"/>
    </visual>
    <collision>
      <origin rpy="1.5707963268 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.026" radius="0.0332"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.08"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="2.655146666666667e-05" ixy="0.0" ixz="0.0" iyy="4.40896e-05" iyz="0.0" izz="2.655146666666667e-05"/>
