{
  mode: "client",
  connect: {
    endpoints: [
      "tcp/100.70.103.60:7447"
    ]
  },
  transport: {
    shared_memory: {
      enabled: false,
      // See config/zenoh_client_local.json5 for why this nested override is
      // needed on top of the outer `enabled: false` -- it's a separate SHM
      // pathway that only kicks in above a 3072-byte threshold and silently
      // drops large messages sent from macOS.
      transport_optimization: {
        enabled: false
      }
    }
  }
}
