# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.egg-info/

# ROS 2 Build Artifacts
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/
ros2_ws/.pixi/

# PlatformIO & Embedded Builds
.pio/
*/.pio/
stm32/Debug/
stm32/.pio/
*.elf
*.bin
*.hex
*.list
*.map
*.o
*.d
*.su

# *.bin above targets STM32/PlatformIO firmware artifacts, but Ultralytics'
# NCNN export also emits a weights file named model.ncnn.bin -- track that
# one like models/best.onnx and models/best.pt already are.
!models/**/*.bin

# IDE & OS files
.DS_Store
.vscode/
.idea/

# Runtime output (perception verification grid, etc.)
ros2_ws/runs/
